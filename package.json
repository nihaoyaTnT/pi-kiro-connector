{
  "name": "pi-kiro-connector",
  "version": "0.1.0",
  "description": "Native Kiro Runtime provider for Pi with model discovery, streaming, reasoning, and tools.",
  "type": "module",
  "license": "MIT",
  "author": "nihaoyaTnT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nihaoyaTnT/pi-kiro-connector.git"
  },
  "homepage": "https://github.com/nihaoyaTnT/pi-kiro-connector#readme",
  "bugs": {
    "url": "https://github.com/nihaoyaTnT/pi-kiro-connector/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "kiro",
    "kiro-runtime",
    "aws-eventstream",
    "coding-agent"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "node ./tests/smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run check && npm test && npm run smoke && npm run pack:check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/kiro-connector.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
